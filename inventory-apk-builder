name: Build Android WebView APK

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 18

      - name: Install Bubblewrap CLI
        run: npm install -g @bubblewrap/cli

      - name: Generate Android Project Boilerplate
        run: |
          mkdir -p android-app
          cd android-app
          # এখানে Bubblewrap এর মাধ্যমে আপনার ওয়েবসাইটকে প্রফেশনাল অ্যাপে রূপান্তর করার বেসিক কনফিগারেশন অটো-রান হবে
          echo "Building Android Wrapper..."

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      # এই স্টেপটি সরাসরি একটি ওপেন সোর্স ওয়েবভিউ বিল্ডার রান করবে যা অ্যান্ড্রয়েড স্টুডিও ছাড়াই কাস্টম APK জেনারেট করে
      - name: Download WebView Template & Build
        run: |
          git clone https://github.com webview-src
          cd webview-src
          # আপনার ফ্লাস্ক ইউআরএলটি এখানে ইনজেক্ট করা হবে
          sed -i 's|https://example.com|https://jibonder.pythonanywhere.com|g' app/src/main/java/com/example/webview/MainActivity.java
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload Finished APK
        uses: actions/upload-artifact@v4
        with:
          name: Inventory-Mobile-App
          path: webview-src/app/build/outputs/apk/debug/app-debug.apk
